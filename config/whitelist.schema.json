{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kotisatama whitelist",
  "type": "object",
  "required": ["domains"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Document version (2.0 for tagged entries)."
    },
    "updated": {
      "type": "string",
      "description": "ISO date when the list was last updated."
    },
    "description": {
      "type": "string"
    },
    "domains": {
      "type": "array",
      "description": "Curated whitelist entries. v1: plain domain strings. v2: objects with tags.",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": ["domain"],
            "additionalProperties": false,
            "properties": {
              "domain": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string"
              },
              "tags": {
                "type": "array",
                "items": { "type": "string" }
              },
              "type": {
                "type": "string",
                "enum": ["white"]
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
