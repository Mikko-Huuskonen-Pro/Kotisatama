{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kotisatama whitelist",
  "type": "object",
  "required": ["domains"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Document version (2.1 for unified whitelist with categories and types)."
    },
    "updated": {
      "type": "string",
      "description": "ISO date when the list was last updated."
    },
    "description": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "description": "Toimialojen metatiedot (v2.1). UI käyttää icon-kenttää SVG-valintaan.",
      "items": {
        "type": "object",
        "required": ["id", "label", "icon"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "icon": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer" }
        }
      }
    },
    "types": {
      "type": "array",
      "description": "Värien metatiedot (v2.1): white = julkinen/nonprofit, yellow = kaupallinen.",
      "items": {
        "type": "object",
        "required": ["id", "label", "icon"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "enum": ["white", "yellow"] },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "icon": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer" }
        }
      }
    },
    "domains": {
      "type": "array",
      "description": "Kuratoidut whitelist-merkinnät. v1: plain domain strings. v2+: objects with metadata.",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": ["domain"],
            "additionalProperties": false,
            "properties": {
              "domain": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string"
              },
              "category": {
                "type": "string",
                "description": "Viittaa categories[].id-kenttään."
              },
              "tags": {
                "type": "array",
                "items": { "type": "string" }
              },
              "type": {
                "type": "string",
                "enum": ["white", "yellow"]
              },
              "entry_url": {
                "type": "string",
                "format": "uri",
                "description": "Kanoninen navigointi-URL (esim. https://www.example.fi/ kun apex ei toimi)."
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
